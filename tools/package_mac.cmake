# Bundle a relocatable SDL runtime and sign this development app ad hoc.
file(MAKE_DIRECTORY "${BUNDLE}/Contents/Frameworks" "${BUNDLE}/Contents/Resources")
get_filename_component(SDL_NAME "${SDL_LIBRARY}" NAME)
set(EMBEDDED "${BUNDLE}/Contents/Frameworks/${SDL_NAME}")
file(COPY_FILE "${SDL_LIBRARY}" "${EMBEDDED}" ONLY_IF_DIFFERENT)
file(CHMOD "${EMBEDDED}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
execute_process(COMMAND /usr/bin/otool -D "${SDL_LIBRARY}" OUTPUT_VARIABLE IDS COMMAND_ERROR_IS_FATAL ANY)
# `otool -D` prints the file name, then its install name, one per line.
string(STRIP "${IDS}" IDS)
string(REPLACE "\n" ";" IDS "${IDS}")
list(GET IDS -1 SDL_ID)
string(STRIP "${SDL_ID}" SDL_ID)
if(NOT SDL_ID OR SDL_ID MATCHES ":$")
    message(FATAL_ERROR "Cannot read the SDL3 install name from ${SDL_LIBRARY}")
endif()
execute_process(COMMAND /usr/bin/install_name_tool -id "@loader_path/${SDL_NAME}" "${EMBEDDED}" COMMAND_ERROR_IS_FATAL ANY)
# Bind directly to the embedded runtime, independent of any runpath ordering.
set(SDL_BUNDLED_ID "@executable_path/../Frameworks/${SDL_NAME}")
execute_process(COMMAND /usr/bin/install_name_tool -change "${SDL_ID}" "${SDL_BUNDLED_ID}" "${EXECUTABLE}" COMMAND_ERROR_IS_FATAL ANY)
# Also repair apps that were previously packaged with the old @rpath spelling.
execute_process(COMMAND /usr/bin/install_name_tool -change "@rpath/${SDL_NAME}" "${SDL_BUNDLED_ID}" "${EXECUTABLE}" COMMAND_ERROR_IS_FATAL ANY)
include("${CMAKE_CURRENT_LIST_DIR}/verify_mac_bundle.cmake")
file(COPY_FILE "${SOURCE}/gnu.txt" "${BUNDLE}/Contents/Resources/GPL.txt")
get_filename_component(SDL_DIR "${SDL_LIBRARY}" DIRECTORY)
file(GLOB SDL_LICENSE "${SDL_DIR}/../share/licenses/SDL3/LICENSE.txt" "${SDL_DIR}/../LICENSE.txt")
if(NOT SDL_LICENSE)
    message(FATAL_ERROR "SDL3 license not found beside SDK; package must include its license")
endif()
list(GET SDL_LICENSE 0 SDL_LICENSE)
file(COPY_FILE "${SDL_LICENSE}" "${BUNDLE}/Contents/Resources/SDL3-LICENSE.txt")
execute_process(COMMAND /usr/bin/codesign --force --deep --sign - "${BUNDLE}" COMMAND_ERROR_IS_FATAL ANY)
