# Reject developer-machine dependencies in every architecture of the app and SDL.
if(NOT BUNDLE)
    message(FATAL_ERROR "BUNDLE must name the app to verify")
endif()
set(APP_EXECUTABLE "${BUNDLE}/Contents/MacOS/LuminousQuake")
file(GLOB BUNDLE_LIBRARIES "${BUNDLE}/Contents/Frameworks/*.dylib")
if(NOT BUNDLE_LIBRARIES)
    message(FATAL_ERROR "${BUNDLE} has no embedded runtime")
endif()
foreach(binary IN ITEMS "${APP_EXECUTABLE}" ${BUNDLE_LIBRARIES})
    execute_process(COMMAND /usr/bin/otool -arch all -L "${binary}"
        OUTPUT_VARIABLE linked COMMAND_ERROR_IS_FATAL ANY)
    string(REGEX MATCHALL "\n\t[^\n]+" dependencies "${linked}")
    foreach(line IN LISTS dependencies)
        string(REGEX REPLACE "^\n\t(.*) \\(compatibility version.*$" "\\1" dependency "${line}")
        if(dependency MATCHES "^/System/Library/" OR dependency MATCHES "^/usr/lib/")
            continue()
        endif()
        if(dependency MATCHES "^@executable_path/../Frameworks/[^/]+$" OR
           dependency MATCHES "^@loader_path/[^/]+$")
            get_filename_component(name "${dependency}" NAME)
            if(EXISTS "${BUNDLE}/Contents/Frameworks/${name}")
                continue()
            endif()
        endif()
        message(FATAL_ERROR "Non-bundled dependency in ${binary}: ${dependency}")
    endforeach()
    if(binary STREQUAL APP_EXECUTABLE AND NOT linked MATCHES "@executable_path/../Frameworks/libSDL3[^/\n]*\\.dylib")
        message(FATAL_ERROR "App must load SDL directly from Contents/Frameworks")
    endif()
    execute_process(COMMAND /usr/bin/otool -arch all -l "${binary}"
        OUTPUT_VARIABLE commands COMMAND_ERROR_IS_FATAL ANY)
    string(REGEX MATCHALL "path [^\n]+ \\(offset [0-9]+\\)" runpaths "${commands}")
    foreach(runpath IN LISTS runpaths)
        if(NOT runpath MATCHES "^path @executable_path/../Frameworks ")
            message(FATAL_ERROR "Unexpected runtime search path in ${binary}: ${runpath}")
        endif()
    endforeach()
endforeach()
